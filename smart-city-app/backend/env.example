# Environment Variables for AI Smart City Backend

# Server Configuration
PORT=3001
NODE_ENV=development

# API Keys
# OPENAI_API_KEY=your_openai_key
# OPENWEATHER_API_KEY=your_openweather_key (optional - Open-Meteo is used by default, no key needed!)
# OPENROUTESERVICE_API_KEY=your_openrouteservice_key

# BKK FUTÁR API (Budapest Public Transport)
# Get your API key from: https://go.bkk.hu/ (Key Management)
# BKK_API_KEY=your_bkk_api_key_here
# BKK_API_ENABLED=true

# MOL Bubi API (Budapest Bike Sharing)
# MOL_BUBI_API_ENABLED=false

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# Chat rate limit (requests per minute per IP)
CHAT_RATE_LIMIT_MAX=20
